# The BambooHR API key is not a setting and does not belong in a checked-in
# .env file. It reaches the server in one of two ways only:
#
#   - Claude Desktop: the install dialog asks for it, keeps it in the OS
#     credential store and passes it to the server process in BAMBOOHR_API_KEY.
#   - Everywhere else: the enroll subcommand writes it to the OS credential
#     store (macOS Keychain, Windows DPAPI, Linux Secret Service):
#
#         node dist/index.js enroll
#
# On the first start with BAMBOOHR_API_KEY set, the server copies the key into
# the same credential store, so status/doctor and command-line use keep working.
# The key is never written to config.json or to any log.
#
# The settings below are non-secret overrides for the values stored in
# config.json (its path is printed by `node dist/index.js status`). The Claude
# Desktop install dialog feeds the first two.

# Subdomain only: "acme" for https://acme.bamboohr.com
BAMBOOHR_COMPANY_DOMAIN=
# Optional. Name or id of the time-off type that counts as vacation.
# If unset, the first type whose name contains "vacation", "annual leave" or "puhkus" is used.
BAMBOOHR_VACATION_TYPE=
# Optional. 1/true enables the tools that expose dependents and employee files.
BAMBOOHR_ENABLE_SENSITIVE_TOOLS=
# Optional. Per-call record cap, 1..500 (default 25).
BAMBOOHR_MAX_RECORDS=
# Optional. https URL of the version revocation document checked at start-up.
BAMBOOHR_REVOCATION_URL=
# Optional. 1/true refuses to start when that check cannot be completed.
BAMBOOHR_STRICT_SELF_CHECK=
# Optional. Overrides the per-user data directory (config.json, audit log, salt).
BAMBOOHR_MCP_DATA_DIR=
